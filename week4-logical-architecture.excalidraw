			"updated": 1791192722882,
			"created": 1790597511457,
			"locked": false,
			"text": "Batcher\nGroups ungraded short answers by\nquestion(based on similarity), so one prompt\ntemplate and rubric is reused across many\nanswers. Cost and consistency both benefit.\n",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "l3dD1dH1BG_Qv8WXE0SvF",
			"originalText": "Batcher\nGroups ungraded short answers by\nquestion(based on similarity), so one prompt\ntemplate and rubric is reused across many\nanswers. Cost and consistency both benefit.\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": "Batcher\nGroups ungraded short answers by\nquestion(based on similarity), so one prompt\ntemplate and rubric is reused across many\nanswers. Cost and consistency both benefit.\n",
			"link": null
		},
