		{
			"id": "87Hf24Y3",
			"type": "text",
			"x": 923.5520277707233,
			"y": 1801.2984842644148,
			"width": 512.03955078125,
			"height": 275,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
			"fillStyle": "cross-hatch",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b4i",
			"roundness": null,
			"seed": 1475702128,
			"version": 727,
			"versionNonce": 31540269,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1791192722879,
			"created": 1790583416829,
			"locked": false,
			"text": "Pattern: Orchestrated Epic Saga\nThe Test Taker is a natural, explicit orchestrator:\nit\nknows the current state and drives each next step\ndeterministically\nConsistency: Atomic\n\nFailures:\n- Answer Captures not available\n- Answer Capture reports message malformed\n- Answer Capturer times-out (backoff, backpressure)",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "0xfdkej599BoiXmAMGiIp",
			"originalText": "Pattern: Orchestrated Epic Saga\nThe Test Taker is a natural, explicit orchestrator: it\nknows the current state and drives each next step\ndeterministically\nConsistency: Atomic\n\nFailures:\n- Answer Captures not available\n- Answer Capture reports message malformed\n- Answer Capturer times-out (backoff, backpressure)",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": "Pattern: Orchestrated Epic Saga\nThe Test Taker is a natural, explicit orchestrator: it\nknows the current state and drives each next step\ndeterministically\nConsistency: Atomic\n\nFailures:\n- Answer Captures not available\n- Answer Capture reports message malformed\n- Answer Capturer times-out (backoff, backpressure)",
			"link": null
		},
