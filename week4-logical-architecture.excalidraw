		{
			"id": "vE5Xgv9L",
			"type": "text",
			"x": 470.7557981842767,
			"y": 2449.2969538949837,
			"width": 471.97202188638613,
			"height": 210.47619047619025,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3K",
			"roundness": null,
			"seed": 1251884432,
			"version": 1723,
			"versionNonce": 1321064304,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1790673730592,
			"created": 1790538542331,
			"link": null,
			"locked": false,
			"text": "Student session is being validated. This is\nStudent submits his answer to a question in the UI synchronously. Test-Taking service\nreceives the request. \nTest-Teking service delegates synchronously the request to the Test-Taker.\nTest-Taker service sends synchronous request to the Answer Capturer.\n\nThe Answer Capturer performs a basic validation of the request and and sends\nasynchronously the message to a queue to be picked up\nTest for further processing.  Test-Taker receives an acknowledge that the answer is\ngoing to be stored durable very soon.\n\nAfter receiving the acknowledge Test Taker gets synchronously next question to be\nanswered by the given student.\nTest-Taking Service receives synchronously the request containing the questions.\nTest-Taking Service presents the question to the student.\nTaker gets the next question",
			"fontSize": 10.523809523809513,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Student session is being validated. This is\nStudent submits his answer to a question in the UI synchronously. Test-Taking service\nreceives the request. \nTest-Teking service delegates synchronously the request to the Test-Taker.\nTest-Taker service sends synchronous request to the Answer Capturer.\n\nThe Answer Capturer performs a basic validation of the request and and sends\nasynchronously the message to a queue to be picked up\nTest for further processing.  Test-Taker receives an acknowledge that the answer is\ngoing to be stored durable very soon.\n\nAfter receiving the acknowledge Test Taker gets synchronously next question to be\nanswered by the given student.\nTest-Taking Service receives synchronously the request containing the questions.\nTest-Taking Service presents the question to the student.\nTaker gets the next question",
			"autoResize": false,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
